# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=codeabroad
DB_PASSWORD=codeabroad_secret
DB_NAME=codeabroad
DB_SSLMODE=disable

# Cache & Streak (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Event Streaming (Kafka)
